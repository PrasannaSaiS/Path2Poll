# Path2Poll Environment Variables
# Copy this file to .env and fill in your API keys

# Google Gemini API Key (required)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Civic Information API Key (optional, enhances accuracy)
# Enable at: https://console.cloud.google.com/apis/library/civicinfo.googleapis.com
CIVIC_INFORMATION_API=your_civic_api_key_here

# Server port (default: 8080, Cloud Run sets this automatically)
PORT=8080
