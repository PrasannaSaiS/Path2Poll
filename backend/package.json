{
  "name": "path2poll-backend",
  "version": "1.0.0",
  "description": "Path2Poll — AI-powered election assistant backend",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "npx --node-options=--experimental-vm-modules jest --coverage --forceExit --detectOpenHandles",
    "test:watch": "npx --node-options=--experimental-vm-modules jest --watch",
    "lint": "npx eslint . --ignore-pattern node_modules --ignore-pattern coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/"
    ]
  },
  "keywords": [
    "election",
    "ai",
    "gemini",
    "civic"
  ],
  "author": "Path2Poll Team",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/firestore": "^8.5.0",
    "@google-cloud/logging": "^11.2.1",
    "@google/genai": "^1.50.1",
    "axios": "^1.15.2",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "eslint": "^10.2.1",
    "jest": "^30.3.0",
    "supertest": "^7.2.2"
  }
}
